# JovidxonChat Backend — тағйирёбандаҳои муҳит.
#
# Render: ҳамаи инҳо дар render.yaml ва Dashboard → jovidxon-chat → Environment танзим мешаванд.
# Кори маҳаллӣ: нусха → .env, баъд `npm run dev` (.env-ро мехонад).
#
# Танзимоти корӣ (SMS, Google, лимитҳои медиа, реҷаи хизматӣ, зангҳо) дар база (ҷадвали
# app_settings) нигоҳ дошта мешаванд ва аз панели админ (/admin → Танзимот) иваз мешаванд.
# Қиматҳои поён танҳо пешфарзанд: қимате, ки дар панел сабт шудааст, аз env муҳимтар аст.

# ------------------------------------------------------------------ ҳатмӣ
# Render: худкор аз базаи jovidxon-db (пайвасти дохилӣ, бе SSL).
DATABASE_URL=postgres://jovidxon:password@127.0.0.1:5432/jovidxon
# ≥ 32 аломати тасодуфӣ. Баъди оғози кор иваз накунед (token-ҳо ва калидҳои махфии база).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=

# ------------------------------------------------------------------ сервер
NODE_ENV=development
PORT=8080
# HOST=0.0.0.0
# auto: localhost ва хости дохилии Render (бе нуқта) — бе SSL, дигарон — SSL бо санҷиши сертификат.
# External URL-и базаи Render аз компютер: агар хатои "self-signed certificate" бошад — no-verify.
# DATABASE_SSL=auto            # auto | disable | require | no-verify
# DATABASE_POOL_MAX=10
# Суроғаи ҷамъиятӣ (пешфарз дар Render: RENDER_EXTERNAL_URL).
# PUBLIC_URL=https://jovidxon-chat.onrender.com
# render (пешфарз) | true | false | шумораи проксиҳо | рӯйхати IP/CIDR
# TRUST_PROXY=render
# LOG_LEVEL=info               # fatal | error | warn | info | debug | silent
# WORKERS=true                 # push, тоза кардани медиа/сессияҳо
# RATE_LIMIT_MULTIPLIER=1

# ------------------------------------------------------------------ админ
# Коди насби якумин админ. Агар холӣ бошад, сервер кодро дар log менависад.
# ADMIN_SETUP_CODE=
# Пароли фаромӯшшуда: ADMIN_RESET=username:ПаролиНав-123 → deploy → даромадан → ин сатрро нест кунед.
# ADMIN_RESET=
# ADMIN_DIST=../admin_panel/dist

# ------------------------------------------------------------------ SMS (OTP)
SMS_DRIVER=log                 # log (код дар log, танҳо барои санҷиш) | alif | smsgate | null
SMS_FALLBACK_DRIVER=           # агар асосӣ ноком шавад: smsgate | alif
SMS_ALIF_URL=https://sms2.aliftech.net/api/v1/sms
SMS_ALIF_API_KEY=
SMS_ALIF_SENDER=
SMS_ALIF_TYPE=1
SMS_GATE_URL=https://api.sms-gate.app/3rdparty/v1/messages
SMS_GATE_USER=
SMS_GATE_PASSWORD=
SMS_GATE_DEVICE_ID=
SMS_GATE_SIM_NUMBER=0          # 0 — SIM-и пешфарзи телефон, 1..4 — SIM-и муайян
# Рақамҳои санҷишӣ бе SMS (масалан барои Google Play): +992900000001:1234,+992900000002:5678
OTP_TEST_NUMBERS=

# ------------------------------------------------------------------ Google
# Web client ID (serverClientId-и барнома). Якчанд — бо вергул.
GOOGLE_CLIENT_IDS=

# ------------------------------------------------------------------ истифода
REGISTRATION_ENABLED=true
MAINTENANCE_MODE=false
MEDIA_MAX_IMAGE_MB=30
MEDIA_MAX_VIDEO_MB=100
MEDIA_MAX_VOICE_MB=16
MEDIA_MAX_DOCUMENT_MB=100
MEDIA_USER_QUOTA_MB=0          # 0 — бе маҳдудият
MESSAGE_EDIT_WINDOW_HOURS=48
GROUP_MAX_MEMBERS=1000
STORY_TTL_HOURS=24

# ------------------------------------------------------------------ зангҳо (WebRTC)
CALLS_ENABLED=true
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=                   # coturn use-auth-secret (ё TURN_USERNAME + TURN_CREDENTIAL)
TURN_USERNAME=
TURN_CREDENTIAL=

# ------------------------------------------------------------------ push (FCM)
# Мундариҷаи JSON-и service account (як сатр). Беҳтар аст дар панели админ ворид кунед.
FCM_SERVICE_ACCOUNT_JSON=
